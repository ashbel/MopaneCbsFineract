<?xml version='1.0' encoding='UTF-8'?>
<jasperReport name="Obligation Met Loans Details(Pentaho)" pageWidth="1300" pageHeight="595" orientation="Landscape" columnWidth="1260" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="userhierarchy" class="java.lang.String" />
    <parameter name="userid" class="java.lang.String" />
    <parameter name="startDate" class="java.lang.String" />
    <parameter name="endDate" class="java.lang.String" />
    <parameter name="Branch" class="java.lang.String" />
    <parameter name="CurrencyId" class="java.lang.String" />
    <parameter name="fundId" class="java.lang.String" />
    <parameter name="loanProductId" class="java.lang.String" />
    <parameter name="loanPurposeId" class="java.lang.String" />
    <parameter name="obligDateType" class="java.lang.String" />
    <field name="Office/Branch" class="java.lang.String" />
    <field name="Currency" class="java.lang.String" />
    <field name="period" class="java.lang.String" />
    <field name="Client Account No." class="java.lang.String" />
    <field name="Client" class="java.lang.String" />
    <field name="Loan Account No." class="java.lang.String" />
    <field name="Product" class="java.lang.String" />
    <field name="Fund" class="java.lang.String" />
    <field name="Loan Amount" class="java.lang.String" />
    <field name="Total Repaid" class="java.lang.String" />
    <field name="Annual Nominal Interest Rate" class="java.lang.String" />
    <field name="Disbursed" class="java.lang.String" />
    <field name="Closed" class="java.lang.String" />
    <field name="Principal Repaid" class="java.lang.String" />
    <field name="Interest Repaid" class="java.lang.String" />
    <field name="Fees Repaid" class="java.lang.String" />
    <field name="Penalties Repaid" class="java.lang.String" />
    <field name="Loan Officer" class="java.lang.String" />
    <query language="SQL">select concat(repeat("..",   
   ((LENGTH(ounder.`hierarchy`) - LENGTH(REPLACE(ounder.`hierarchy`, '.', '')) - 1))), ounder.`name`) as "Office/Branch",ounder.name, ounder.id,
ifnull(cur.display_symbol, l.currency_code) as Currency,concat("From"," ",$P{startDate}," ","To"," " ,$P{endDate})as period,
c.account_no as "Client Account No.", c.display_name as "Client",
l.account_no as "Loan Account No.", pl.`name` as "Product", 
ifnull(f.`name`,'-') as Fund,  
l.principal_amount as "Loan Amount", 
l.total_repayment_derived  as "Total Repaid", 
l.annual_nominal_interest_rate as " Annual Nominal Interest Rate", 
date(l.disbursedon_date) as "Disbursed", 
date(l.closedon_date) as "Closed",

l.principal_repaid_derived as "Principal Repaid",
l.interest_repaid_derived as "Interest Repaid",
ifnull(l.fee_charges_repaid_derived,0) as "Fees Repaid",
ifnull(l.penalty_charges_repaid_derived,0) as "Penalties Repaid",
ifnull(lo.display_name,'-') as "Loan Officer"

from m_office o 
join m_office ounder on ounder.hierarchy like concat(o.hierarchy, '%')
and ounder.hierarchy like concat($P{userhierarchy}, '%')
join m_client c on c.office_id = ounder.id
join m_loan l on l.client_id = c.id
join m_product_loan pl on pl.id = l.product_id
left join m_staff lo on lo.id = l.loan_officer_id
left join m_currency cur on cur.code = l.currency_code
left join m_fund f on f.id = l.fund_id


where o.id = $P{Branch}
and (ifnull(l.loan_officer_id, -10) = -1 or -1 = -1)
and (l.currency_code = $P{CurrencyId} or -1 = $P{CurrencyId})
and (ifnull(l.fund_id, -10) = $P{fundId} or -1 = $P{fundId})
and (l.product_id = $P{loanProductId} or -1 = $P{loanProductId})
and (ifnull(l.loanpurpose_cv_id, -10) = $P{loanPurposeId} or -1 = $P{loanPurposeId})
and (case
	when $P{obligDateType} = 1 then
    l.closedon_date between $P{startDate} and $P{endDate}
	when $P{obligDateType} = 2 then
    l.disbursedon_date between $P{startDate} and $P{endDate}
	else 1 = 1
	end)
and l.loan_status_id = 600
group by l.id
order by ounder.hierarchy, l.currency_code, c.account_no, l.account_no</query>
    <title height="30">
        <element kind="staticText" x="0" y="0" width="700" height="24" fontSize="14" bold="true"><text>Obligation Met Loans Details(Pentaho)</text></element></title>
    <columnHeader height="22">
        <element kind="staticText" x="20" y="0" width="66" height="20"><text>Office/Branch</text></element><element kind="staticText" x="90" y="0" width="66" height="20"><text>Currency</text></element><element kind="staticText" x="160" y="0" width="66" height="20"><text>period</text></element><element kind="staticText" x="230" y="0" width="66" height="20"><text>Client Account No.</text></element><element kind="staticText" x="300" y="0" width="66" height="20"><text>Client</text></element><element kind="staticText" x="370" y="0" width="66" height="20"><text>Loan Account No.</text></element><element kind="staticText" x="440" y="0" width="66" height="20"><text>Product</text></element><element kind="staticText" x="510" y="0" width="66" height="20"><text>Fund</text></element><element kind="staticText" x="580" y="0" width="66" height="20"><text>Loan Amount</text></element><element kind="staticText" x="650" y="0" width="66" height="20"><text>Total Repaid</text></element><element kind="staticText" x="720" y="0" width="66" height="20"><text>Annual Nominal Interest Rate</text></element><element kind="staticText" x="790" y="0" width="66" height="20"><text>Disbursed</text></element><element kind="staticText" x="860" y="0" width="66" height="20"><text>Closed</text></element><element kind="staticText" x="930" y="0" width="66" height="20"><text>Principal Repaid</text></element><element kind="staticText" x="1000" y="0" width="66" height="20"><text>Interest Repaid</text></element><element kind="staticText" x="1070" y="0" width="66" height="20"><text>Fees Repaid</text></element><element kind="staticText" x="1140" y="0" width="66" height="20"><text>Penalties Repaid</text></element><element kind="staticText" x="1210" y="0" width="66" height="20"><text>Loan Officer</text></element></columnHeader>
    <detail>
        <band height="18">
            <element kind="textField" blankWhenNull="true" x="20" y="0" width="66" height="18"><expression>$F{Office/Branch}</expression></element><element kind="textField" blankWhenNull="true" x="90" y="0" width="66" height="18"><expression>$F{Currency}</expression></element><element kind="textField" blankWhenNull="true" x="160" y="0" width="66" height="18"><expression>$F{period}</expression></element><element kind="textField" blankWhenNull="true" x="230" y="0" width="66" height="18"><expression>$F{Client Account No.}</expression></element><element kind="textField" blankWhenNull="true" x="300" y="0" width="66" height="18"><expression>$F{Client}</expression></element><element kind="textField" blankWhenNull="true" x="370" y="0" width="66" height="18"><expression>$F{Loan Account No.}</expression></element><element kind="textField" blankWhenNull="true" x="440" y="0" width="66" height="18"><expression>$F{Product}</expression></element><element kind="textField" blankWhenNull="true" x="510" y="0" width="66" height="18"><expression>$F{Fund}</expression></element><element kind="textField" blankWhenNull="true" x="580" y="0" width="66" height="18"><expression>$F{Loan Amount}</expression></element><element kind="textField" blankWhenNull="true" x="650" y="0" width="66" height="18"><expression>$F{Total Repaid}</expression></element><element kind="textField" blankWhenNull="true" x="720" y="0" width="66" height="18"><expression>$F{Annual Nominal Interest Rate}</expression></element><element kind="textField" blankWhenNull="true" x="790" y="0" width="66" height="18"><expression>$F{Disbursed}</expression></element><element kind="textField" blankWhenNull="true" x="860" y="0" width="66" height="18"><expression>$F{Closed}</expression></element><element kind="textField" blankWhenNull="true" x="930" y="0" width="66" height="18"><expression>$F{Principal Repaid}</expression></element><element kind="textField" blankWhenNull="true" x="1000" y="0" width="66" height="18"><expression>$F{Interest Repaid}</expression></element><element kind="textField" blankWhenNull="true" x="1070" y="0" width="66" height="18"><expression>$F{Fees Repaid}</expression></element><element kind="textField" blankWhenNull="true" x="1140" y="0" width="66" height="18"><expression>$F{Penalties Repaid}</expression></element><element kind="textField" blankWhenNull="true" x="1210" y="0" width="66" height="18"><expression>$F{Loan Officer}</expression></element></band>
    </detail>
</jasperReport>