        <element kind="staticText" x="20" y="0" width="156" height="20"><text>section</text></element><element kind="staticText" x="180" y="0" width="156" height="20"><text>glcode</text></element><element kind="staticText" x="340" y="0" width="156" height="20"><text>name</text></element><element kind="staticText" x="500" y="0" width="156" height="20"><text>balance</text></element></columnHeader>
    <detail>
        <band height="18">
            <element kind="textField" blankWhenNull="true" x="20" y="0" width="156" height="18"><expression>$F{section}</expression></element><element kind="textField" blankWhenNull="true" x="180" y="0" width="156" height="18"><expression>$F{glcode}</expression></element><element kind="textField" blankWhenNull="true" x="340" y="0" width="156" height="18"><expression>$F{name}</expression></element><element kind="textField" blankWhenNull="true" x="500" y="0" width="156" height="18"><expression>$F{balance}</expression></element></band>
    </detail>
</jasperReport>