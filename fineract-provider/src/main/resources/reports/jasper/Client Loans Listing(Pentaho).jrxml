 width="66" height="20"><text>Term Frequency</text></element><element kind="staticText" x="1420" y="0" width="66" height="20"><text>Term Frequency Period</text></element><element kind="staticText" x="1490" y="0" width="66" height="20"><text>Repayment Frequency</text></element><element kind="staticText" x="1560" y="0" width="66" height="20"><text>Repayment Frequency Period</text></element><element kind="staticText" x="1630" y="0" width="66" height="20"><text>Amortization</text></element><element kind="staticText" x="1700" y="0" width="66" height="20"><text>Total Charges Due At Disbursement</text></element><element kind="staticText" x="1770" y="0" width="66" height="20"><text>Submitted</text></element><element kind="staticText" x="1840" y="0" width="66" height="20"><text>Expected Disbursal</text></element><element kind="staticText" x="1910" y="0" width="66" height="20"><text>Expected First Repayment</text></element><element kind="staticText" x="1980" y="0" width="66" height="20"><text>Interest Calculated From</text></element><element kind="staticText" x="2050" y="0" width="66" height="20"><text>Disbursed</text></element><element kind="staticText" x="2120" y="0" width="66" height="20"><text>Matured On</text></element><element kind="staticText" x="2190" y="0" width="66" height="20"><text>Closed</text></element><element kind="staticText" x="2260" y="0" width="66" height="20"><text>Rejected</text></element><element kind="staticText" x="2330" y="0" width="66" height="20"><text>Rescheduled</text></element><element kind="staticText" x="2400" y="0" width="66" height="20"><text>Withdrawn</text></element></columnHeader>
    <detail>
        <band height="18">
            <element kind="textField" blankWhenNull="true" x="20" y="0" width="66" height="18"><expression>$F{Office/Branch}</expression></element><element kind="textField" blankWhenNull="true" x="90" y="0" width="66" height="18"><expression>$F{Client Account No.}</expression></element><element kind="textField" blankWhenNull="true" x="160" y="0" width="66" height="18"><expression>$F{Name}</expression></element><element kind="textField" blankWhenNull="true" x="230" y="0" width="66" height="18"><expression>$F{Client Status}</expression></element><element kind="textField" blankWhenNull="true" x="300" y="0" width="66" height="18"><expression>$F{Loan Officer}</expression></element><element kind="textField" blankWhenNull="true" x="370" y="0" width="66" height="18"><expression>$F{Loan Account No.}</expression></element><element kind="textField" blankWhenNull="true" x="440" y="0" width="66" height="18"><expression>$F{External Id}</expression></element><element kind="textField" blankWhenNull="true" x="510" y="0" width="66" height="18"><expression>$F{Loan}</expression></element><element kind="textField" blankWhenNull="true" x="580" y="0" width="66" height="18"><expression>$F{Status}</expression></element><element kind="textField" blankWhenNull="true" x="650" y="0" width="66" height="18"><expression>$F{Fund}</expression></element><element kind="textField" blankWhenNull="true" x="720" y="0" width="66" height="18"><expression>$F{Loan Purpose}</expression></element><element kind="textField" blankWhenNull="true" x="790" y="0" width="66" height="18"><expression>$F{Currency}</expression></element><element kind="textField" blankWhenNull="true" x="860" y="0" width="66" height="18"><expression>$F{Arrears Tolerance Amount}</expression></element><element kind="textField" blankWhenNull="true" x="930" y="0" width="66" height="18"><expression>$F{Expected No. Repayments}</expression></element><element kind="textField" blankWhenNull="true" x="1000" y="0" width="66" height="18"><expression>$F{