<?xml version='1.0' encoding='UTF-8'?>
<jasperReport name="Obligation Met Loans Summary(Pentaho)" pageWidth="950" pageHeight="595" orientation="Landscape" columnWidth="910" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="userhierarchy" class="java.lang.String" />
    <parameter name="userid" class="java.lang.String" />
    <parameter name="Startdate" class="java.lang.String" />
    <parameter name="Enddate" class="java.lang.String" />
    <parameter name="startDate" class="java.lang.String" />
    <parameter name="endDate" class="java.lang.String" />
    <parameter name="Branch" class="java.lang.String" />
    <parameter name="CurrencyId" class="java.lang.String" />
    <parameter name="loanProductId" class="java.lang.String" />
    <parameter name="loanPurposeId" class="java.lang.String" />
    <parameter name="fundId" class="java.lang.String" />
    <parameter name="obligDateType" class="java.lang.String" />
    <field name="Office/Branch" class="java.lang.String" />
    <field name="Currency" class="java.lang.String" />
    <field name="period" class="java.lang.String" />
    <field name="No. of Clients" class="java.lang.String" />
    <field name="No. of Loans" class="java.lang.String" />
    <field name="Total Loan Amount" class="java.lang.String" />
    <field name="Total Principal Repaid" class="java.lang.String" />
    <field name="Total Interest Repaid" class="java.lang.String" />
    <field name="Total Fees Repaid" class="java.lang.String" />
    <field name="Total Penalties Repaid" class="java.lang.String" />
    <field name="Total Interest Waived" class="java.lang.String" />
    <field name="Total Fees Waived" class="java.lang.String" />
    <field name="Total Penalties Waived" class="java.lang.String" />
    <query language="SQL">select concat(repeat("..",   
   ((LENGTH(ounder.`hierarchy`) - LENGTH(REPLACE(ounder.`hierarchy`, '.', '')) - 1))), ounder.`name`) as "Office/Branch",ounder.name, ounder.id,
ifnull(cur.display_symbol, l.currency_code) as Currency,
concat("From"," ",$P{startDate}," ","To"," " ,$P{endDate})as "period",
count(distinct(c.id)) as "No. of Clients",
count(distinct(l.id)) as "No. of Loans",
sum(l.principal_amount) as "Total Loan Amount", 
sum(l.principal_repaid_derived) as "Total Principal Repaid",
sum(l.interest_repaid_derived) as "Total Interest Repaid",
sum(l.fee_charges_repaid_derived) as "Total Fees Repaid",
sum(l.penalty_charges_repaid_derived) as "Total Penalties Repaid",
sum(l.interest_waived_derived) as "Total Interest Waived",
sum(l.fee_charges_waived_derived) as "Total Fees Waived",
sum(l.penalty_charges_waived_derived) as "Total Penalties Waived"

from m_office o 
join m_office ounder on ounder.hierarchy like concat(o.hierarchy, '%')
and ounder.hierarchy like concat($P{userhierarchy}, '%')
join m_client c on c.office_id = ounder.id
join m_loan l on l.client_id = c.id
join m_product_loan pl on pl.id = l.product_id
left join m_staff lo on lo.id = l.loan_officer_id
left join m_currency cur on cur.code = l.currency_code
left join m_fund f on f.id = l.fund_id
where o.id = $P{Branch}
and (ifnull(l.loan_officer_id, -10) = ${Loan Officer} or "-1" = ${Loan Officer})
and (l.currency_code = $P{CurrencyId} or "-1" = $P{CurrencyId})
and (l.product_id = $P{loanProductId} or "-1" = $P{loanProductId})
and (ifnull(l.loanpurpose_cv_id, -10) = $P{loanPurposeId} or "-1" = $P{loanPurposeId})
and (ifnull(l.fund_id, -10) = $P{fundId} or -1 = $P{fundId})
and (case
	when $P{obligDateType} = 1 then
    l.closedon_date between $P{Startdate} and $P{Enddate}
	when $P{obligDateType} = 2 then
    l.disbursedon_date between $P{Startdate} and $P{Enddate}
	else 1 = 1
	end)
and l.loan_status_id = 600


group by ounder.hierarchy, l.currency_code
order by ounder.hierarchy, l.currency_code</query>
    <title height="30">
        <element kind="staticText" x="0" y="0" width="700" height="24" fontSize="14" bold="true"><text>Obligation Met Loans Summary(Pentaho)</text></element></title>
    <columnHeader height="22">
        <element kind="staticText" x="20" y="0" width="66" height="20"><text>Office/Branch</text></element><element kind="staticText" x="90" y="0" width="66" height="20"><text>Currency</text></element><element kind="staticText" x="160" y="0" width="66" height="20"><text>period</text></element><element kind="staticText" x="230" y="0" width="66" height="20"><text>No. of Clients</text></element><element kind="staticText" x="300" y="0" width="66" height="20"><text>No. of Loans</text></element><element kind="staticText" x="370" y="0" width="66" height="20"><text>Total Loan Amount</text></element><element kind="staticText" x="440" y="0" width="66" height="20"><text>Total Principal Repaid</text></element><element kind="staticText" x="510" y="0" width="66" height="20"><text>Total Interest Repaid</text></element><element kind="staticText" x="580" y="0" width="66" height="20"><text>Total Fees Repaid</text></element><element kind="staticText" x="650" y="0" width="66" height="20"><text>Total Penalties Repaid</text></element><element kind="staticText" x="720" y="0" width="66" height="20"><text>Total Interest Waived</text></element><element kind="staticText" x="790" y="0" width="66" height="20"><text>Total Fees Waived</text></element><element kind="staticText" x="860" y="0" width="66" height="20"><text>Total Penalties Waived</text></element></columnHeader>
    <detail>
        <band height="18">
            <element kind="textField" blankWhenNull="true" x="20" y="0" width="66" height="18"><expression>$F{Office/Branch}</expression></element><element kind="textField" blankWhenNull="true" x="90" y="0" width="66" height="18"><expression>$F{Currency}</expression></element><element kind="textField" blankWhenNull="true" x="160" y="0" width="66" height="18"><expression>$F{period}</expression></element><element kind="textField" blankWhenNull="true" x="230" y="0" width="66" height="18"><expression>$F{No. of Clients}</expression></element><element kind="textField" blankWhenNull="true" x="300" y="0" width="66" height="18"><expression>$F{No. of Loans}</expression></element><element kind="textField" blankWhenNull="true" x="370" y="0" width="66" height="18"><expression>$F{Total Loan Amount}</expression></element><element kind="textField" blankWhenNull="true" x="440" y="0" width="66" height="18"><expression>$F{Total Principal Repaid}</expression></element><element kind="textField" blankWhenNull="true" x="510" y="0" width="66" height="18"><expression>$F{Total Interest Repaid}</expression></element><element kind="textField" blankWhenNull="true" x="580" y="0" width="66" height="18"><expression>$F{Total Fees Repaid}</expression></element><element kind="textField" blankWhenNull="true" x="650" y="0" width="66" height="18"><expression>$F{Total Penalties Repaid}</expression></element><element kind="textField" blankWhenNull="true" x="720" y="0" width="66" height="18"><expression>$F{Total Interest Waived}</expression></element><element kind="textField" blankWhenNull="true" x="790" y="0" width="66" height="18"><expression>$F{Total Fees Waived}</expression></element><element kind="textField" blankWhenNull="true" x="860" y="0" width="66" height="18"><expression>$F{Total Penalties Waived}</expression></element></band>
    </detail>
</jasperReport>