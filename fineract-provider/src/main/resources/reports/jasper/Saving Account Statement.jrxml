<?xml version='1.0' encoding='UTF-8'?>
<jasperReport name="Saving Account Statement" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="userhierarchy" class="java.lang.String" />
    <parameter name="userid" class="java.lang.String" />
    <parameter name="ondate" class="java.lang.String" />
    <parameter name="todate" class="java.lang.String" />
    <parameter name="Account" class="java.lang.String" />
    <field name="type" class="java.lang.String" />
    <field name="Credited" class="java.lang.String" />
    <field name="Debited" class="java.lang.String" />
    <field name="transaction type" class="java.lang.String" />
    <query language="SQL">select 
mst.transaction_date,
case mst.transaction_type_enum
when 1 then 'Deposit'
when 2 then 'Withdrawl'
end as 'type',
  IFnull(mpd.receipt_number, 0) 'Recept_no',
ifnull(concat('Ch: ', mpd.check_number,',','Re: ', mpd.receipt_number,',','B.N0: ',mpd.bank_number,',','R.NO: ',mpd.routing_code, ',','Note: ',ifnull(mn.note,' ')), '') 'Description',

if(mst.transaction_type_enum = 1, mst.amount,0) as 'Credited',
if(mst.transaction_type_enum = 2, mst.amount,0) as 'Debited',
mst.running_balance_derived 'Blance',
case mpd.payment_type_cv_id
when 19 then 'Cash'
when 20 then 'check'
when 21 then 'Airtel Money'
else ' '
end as 'transaction type',
concat(mc.display_name,'(','ID',mc.id,')'),
msa.account_no


from m_savings_account_transaction mst
left join m_savings_account msa
on msa.id=mst.savings_account_id
left join m_payment_detail mpd
on mst.payment_detail_id=mpd.id
left join m_savings_product msp
on msp.id=msa.product_id
left join m_client mc
on msa.client_id=mc.id
left join m_note mn
on mn.savings_account_id=mst.id
where  mst.savings_account_id=$P{Account} and mst.transaction_date between $P{ondate} and $P{todate}</query>
    <title height="30">
        <element kind="staticText" x="0" y="0" width="700" height="24" fontSize="14" bold="true"><text>Saving Account Statement</text></element></title>
    <columnHeader height="22">
        <element kind="staticText" x="20" y="0" width="156" height="20"><text>type</text></element><element kind="staticText" x="180" y="0" width="156" height="20"><text>Credited</text></element><element kind="staticText" x="340" y="0" width="156" height="20"><text>Debited</text></element><element kind="staticText" x="500" y="0" width="156" height="20"><text>transaction type</text></element></columnHeader>
    <detail>
        <band height="18">
            <element kind="textField" blankWhenNull="true" x="20" y="0" width="156" height="18"><expression>$F{type}</expression></element><element kind="textField" blankWhenNull="true" x="180" y="0" width="156" height="18"><expression>$F{Credited}</expression></element><element kind="textField" blankWhenNull="true" x="340" y="0" width="156" height="18"><expression>$F{Debited}</expression></element><element kind="textField" blankWhenNull="true" x="500" y="0" width="156" height="18"><expression>$F{transaction type}</expression></element></band>
    </detail>
</jasperReport>