<?xml version='1.0' encoding='UTF-8'?>
<jasperReport name="Daily Teller Cash Report (Pentaho)" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="userhierarchy" class="java.lang.String" />
    <parameter name="userid" class="java.lang.String" />
    <parameter name="asOnDate" class="java.lang.String" />
    <parameter name="officeId" class="java.lang.String" />
    <parameter name="tellerId" class="java.lang.String" />
    <parameter name="cashierId" class="java.lang.String" />
    <parameter name="currencyCode" class="java.lang.String" />
    <field name="Row Title" class="java.lang.String" />
    <field name="Row Value" class="java.lang.String" />
    <field name="Verification" class="java.lang.String" />
    <query language="SQL">call CashierTransactionSummary($P{officeId},$P{tellerId},$P{cashierId},$P{currencyCode},$P{asOnDate})</query>
    <title height="30">
        <element kind="staticText" x="0" y="0" width="700" height="24" fontSize="14" bold="true"><text>Daily Teller Cash Report (Pentaho)</text></element></title>
    <columnHeader height="22">
        <element kind="staticText" x="20" y="0" width="156" height="20"><text>Row Title</text></element><element kind="staticText" x="180" y="0" width="156" height="20"><text>Row Value</text></element><element kind="staticText" x="340" y="0" width="156" height="20"><text>Verification</text></element></columnHeader>
    <detail>
        <band height="18">
            <element kind="textField" blankWhenNull="true" x="20" y="0" width="156" height="18"><expression>$F{Row Title}</expression></element><element kind="textField" blankWhenNull="true" x="180" y="0" width="156" height="18"><expression>$F{Row Value}</expression></element><element kind="textField" blankWhenNull="true" x="340" y="0" width="156" height="18"><expression>$F{Verification}</expression></element></band>
    </detail>
</jasperReport>