0" y="0" width="66" height="18"><expression>$F{loanId}</expression></element><element kind="textField" blankWhenNull="true" x="1070" y="0" width="66" height="18"><expression>$F{Bname}</expression></element><element kind="textField" blankWhenNull="true" x="1140" y="0" width="66" height="18"><expression>$F{branch}</expression></element><element kind="textField" blankWhenNull="true" x="1210" y="0" width="66" height="18"><expression>$F{Currency}</expression></element><element kind="textField" blankWhenNull="true" x="1280" y="0" width="66" height="18"><expression>$F{Loan Officer}</expression></element><element kind="textField" blankWhenNull="true" x="1350" y="0" width="66" height="18"><expression>$F{Client Account No}</expression></element><element kind="textField" blankWhenNull="true" x="1420" y="0" width="66" height="18"><expression>$F{Client}</expression></element><element kind="textField" blankWhenNull="true" x="1490" y="0" width="66" height="18"><expression>$F{Loan Account No}</expression></element><element kind="textField" blankWhenNull="true" x="1560" y="0" width="66" height="18"><expression>$F{Product}</expression></element><element kind="textField" blankWhenNull="true" x="1630" y="0" width="66" height="18"><expression>$F{Fund}</expression></element><element kind="textField" blankWhenNull="true" x="1700" y="0" width="66" height="18"><expression>$F{Loan Amount}</expression></element><element kind="textField" blankWhenNull="true" x="1770" y="0" width="66" height="18"><expression>$F{Annual Nominal Interest Rate}</expression></element><element kind="textField" blankWhenNull="true" x="1840" y="0" width="66" height="18"><expression>$F{Disbursed}</expression></element><element kind="textField" blankWhenNull="true" x="1910" y="0" width="66" height="18"><expression>$F{Expected Matured On}</expression></element></band>
