        <element kind="staticText" x="20" y="0" width="74" height="20"><text>'Office'</text></element><element kind="staticText" x="98" y="0" width="74" height="20"><text>Officer'</text></element><element kind="staticText" x="176" y="0" width="74" height="20"><text>Number'</text></element><element kind="staticText" x="254" y="0" width="74" height="20"><text>'Name'</text></element><element kind="staticText" x="332" y="0" width="74" height="20"><text>'Product'</text></element><element kind="staticText" x="410" y="0" width="74" height="20"><text>Date'</text></element><element kind="staticText" x="488" y="0" width="74" height="20"><text>'Installment'</text></element><element kind="staticText" x="566" y="0" width="74" height="20"><text>'Currency'</text></element><element kind="staticText" x="644" y="0" width="74" height="20"><text>Due'</text></element><element kind="staticText" x="722" y="0" width="74" height="20"><text>Overdue'</text></element></columnHeader>
    <detail>
        <band height="18">
            <element kind="textField" blankWhenNull="true" x="20" y="0" width="74" height="18"><expression>$F{'Office'}</expression></element><element kind="textField" blankWhenNull="true" x="98" y="0" width="74" height="18"><expression>$F{Officer'}</expression></element><element kind="textField" blankWhenNull="true" x="176" y="0" width="74" height="18"><expression>$F{Number'}</expression></element><element kind="textField" blankWhenNull="true" x="254" y="0" width="74" height="18"><expression>$F{'Name'}</expression></element><element kind="textField" blankWhenNull="true" x="332" y="0" width="74" height="18"><expression>$F{'Product'}</expression></element><element kind="textField" blankWhenNull="true" x="410" y="0" width="74" height="18"><expression>$F{Date'}</expression></element><element kind="textField" blankWhenNull="true" x="488" y="0" width="74" height="18"><expression>$F{'Installment'}</expression></element><element kind="textField" blankWhenNull="true" x="566" y="0" width="74" height="18"><expression>$F{'Currency'}</expression></element><element kind="textField" blankWhenNull="true" x="644" y="0" width="74" height="18"><expression>$F{Due'}</expression></element><element kind="textField" blankWhenNull="true" x="722" y="0" width="74" height="18"><expression>$F{Overdue'}</expression></element></band>
    </detail>
</jasperReport>